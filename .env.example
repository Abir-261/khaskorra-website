# — ডেটাবেস কনফিগারেশন —

# লোকাল ডেভেলপমেন্ট (কম্পিউটারে ফাইল ডেটাবেস):
DATABASE_URL=file:./db/custom.db

# প্রোডাকশন — Vercel + Turso ব্যবহারের সময় নিচের মতো সেট করুন
# (turso.tech অথবা Vercel Storage → Turso থেকে URL ও টোকেন পাবেন):
# DATABASE_URL=libsql://আপনার-ডিবি-আপনার-অর্গ.turso.io
# DATABASE_AUTH_TOKEN=eyJ... (টোকেন)
# ADMIN_PASSCODE=আপনার-গোপন-এডমিন-পাসকোড

# দ্রষ্টব্য: Vercel Marketplace থেকে Turso যোগ করলে স্বয়ংক্রিয়ভাবে
# TURSO_DATABASE_URL ও TURSO_AUTH_TOKEN তৈরি হয় — সেগুলোও কোড নিজে থেকেই ব্যবহার করে।
